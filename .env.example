# ============================================================
#  .env.example — gabarit pour rouler Ai.js EN LOCAL (tests)
#  Copie ce fichier en « .env » et remplis les valeurs depuis
#  Railway → ton service → onglet Variables.
#  ⚠️ Le vrai « .env » est gitignoré : il ne sera JAMAIS commité.
# ============================================================

# Port local (laisse 8080, c'est ce que ngrok exposera)
PORT=8080

# --- Shopify (MINIMUM requis pour tester la recherche produits/prix) ---
SHOPIFY_DOMAIN=
SHOPIFY_TOKEN=
SHOPIFY_API_VERSION=2026-04

# --- VAPI ---
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
VAPI_ASSISTANTS_MAP=

# --- Coach hebdo (Claude + courriel) ---
ANTHROPIC_API_KEY=
RESEND_API_KEY=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=
ANALYSIS_SECRET=
ANALYSIS_TIMEZONE=America/Toronto

# --- Boîte vocale (Resend séparé + Twilio) ---
RESEND_API_KEY_VOICEMAIL=
VOICEMAIL_EMAIL_TO=
VOICEMAIL_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- SMS sortant (chantier 5 : /send-sms + tool Vapi send_sms) ---
# Réutilise TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN ci-dessus.
# Numéro Twilio expéditeur en E.164 (ex: +18196174343 = le numéro Barracuda).
TWILIO_SMS_FROM=
# Texte du SMS de bienvenue envoyé sur « oui » à l'accueil (optionnel, a un défaut).
WELCOME_SMS_TEXT=

# --- Divers ---
# En local, mets l'URL ngrok ici (ex: https://xxxx.ngrok-free.app)
PUBLIC_BASE_URL=
VOICEMAIL_GREETING=
